# ── Secrets ──────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Yedekler (Git artik bu isi yapiyor) ──────────────────
backups/
*.bak
*.bak.*
*.bak_*
*.bak-*
*.backup
*.backup_*
*.backup-*
backup_*
# backup_* would swallow scripts/backup_db.sh, the script the whole
# backup chain depends on. It was never committed as a result.
!scripts/backup_db.sh
*.broken.*
*.pre-restore.*
*.pre_*
*.old
*.orig
*_backup_*

# ── Sanal ortamlar ───────────────────────────────────────
.venv*/
venv/
env/

# ── Uretilmis veri / cache ───────────────────────────────
.spacetrack_catalog_cache.json
.tle_cache.json
.satcat_owners.json
.discos_organisations.json
.tle_archive_progress.json
*.cache.json
.launches_cache*.json
*_cache_*.json
ml/datasets/
ml/cache/

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# ── Loglar ───────────────────────────────────────────────
*.log
logs/

# ── Kisisel / gecici ─────────────────────────────────────
downloads/
_archive/
*.pdf
*.dmg
*.tar.gz
*.zip
*.dump
*.sql.gz

# ── Editor / OS ──────────────────────────────────────────
.DS_Store
*.swp
*~
.idea/
.vscode/

# Written by scripts/deploy.sh at every deploy and rollback, read by /health to
# report which commit an instance is serving. Per-instance state, not source --
# and it MUST stay ignored: deploy gate 2 refuses to run against a dirty
# production tree, so a tracked marker would make the deploy script break the
# next deploy.
.deploy_version.json
